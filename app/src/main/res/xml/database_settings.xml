<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.ivanovsky.passnotes.presentation.core.widget.ProgressPreference
        app:key="@string/pref_progress"
        app:isPreferenceVisible="true"/>

    <SwitchPreferenceCompat
        app:key="@string/pref_is_recycle_bin_enabled"
        app:isPreferenceVisible="false"
        app:title="@string/pref_is_recycle_bin_enabled_title"
        app:summary="@string/pref_is_recycle_bin_enabled_summary"/>

    <com.ivanovsky.passnotes.presentation.core.preference.CustomDialogPreference
        app:key="@string/pref_recycle_bin_group"
        app:isPreferenceVisible="false"
        app:title="@string/pref_recycle_bin_group_title" />

    <com.ivanovsky.passnotes.presentation.core.preference.CustomDialogPreference
        app:key="@string/pref_change_password"
        app:isPreferenceVisible="false"
        app:title="@string/change_password"/>

</PreferenceScreen>